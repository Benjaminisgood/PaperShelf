<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info><title>PaperShelf Author–Year</title><id>https://papershelf.local/styles/author-year</id><updated>2026-10-18T00:00:00Z</updated><rights license="https://opensource.org/license/mit">MIT</rights></info>
  <macro name="author-short"><names variable="author"><name form="short" and="text" delimiter=", "/><substitute><text variable="title"/></substitute></names></macro>
  <macro name="authors"><names variable="author"><name name-as-sort-order="all" initialize-with=". " and="text" delimiter=", "/><substitute><text variable="title"/></substitute></names></macro>
  <macro name="year"><choose><if variable="issued"><date variable="issued"><date-part name="year"/></date></if><else><text term="no date" form="short"/></else></choose></macro>
  <citation disambiguate-add-year-suffix="true" disambiguate-add-names="true" et-al-min="3" et-al-use-first="1"><sort><key macro="author-short"/><key macro="year"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><text macro="author-short"/><text macro="year"/><group delimiter=" "><label variable="locator" form="short"/><text variable="locator"/></group></group></layout></citation>
  <bibliography hanging-indent="true" entry-spacing="1"><sort><key macro="authors"/><key macro="year"/><key variable="title"/></sort><layout suffix="."><group delimiter=". "><text macro="authors"/><text macro="year" prefix="(" suffix=")"/><text variable="title"/><text variable="container-title"/><group delimiter=", "><text variable="volume"/><text variable="issue" prefix="(" suffix=")"/><text variable="page"/></group><text variable="publisher"/><choose><if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if><else><text variable="URL"/></else></choose></group></layout></bibliography>
</style>
