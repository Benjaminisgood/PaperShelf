<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info><title>PaperShelf Numeric</title><id>https://papershelf.local/styles/numeric</id><updated>2026-10-18T00:00:00Z</updated><rights license="https://opensource.org/license/mit">MIT</rights></info>
  <macro name="authors"><names variable="author"><name name-as-sort-order="all" initialize-with=". " delimiter=", " and="text"/><substitute><text variable="title"/></substitute></names></macro>
  <macro name="year"><choose><if variable="issued"><date variable="issued"><date-part name="year"/></date></if><else><text term="no date" form="short"/></else></choose></macro>
  <citation><sort><key variable="citation-number"/></sort><layout prefix="[" suffix="]" delimiter=", "><group delimiter=", "><text variable="citation-number"/><group delimiter=" "><label variable="locator" form="short"/><text variable="locator"/></group></group></layout></citation>
  <bibliography entry-spacing="1" second-field-align="flush"><layout suffix="."><text variable="citation-number" suffix=". "/><group delimiter=". "><text macro="authors"/><text variable="title"/><text variable="container-title"/><group delimiter=", "><text macro="year"/><text variable="volume"/><text variable="issue" prefix="(" suffix=")"/><text variable="page"/></group><text variable="publisher"/><choose><if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if><else><text variable="URL"/></else></choose></group></layout></bibliography>
</style>
